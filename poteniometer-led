int lightBulb = 9;  // Variable for LED
int dimmerController = A1;  // Variable for potentiometer
int dimmerValue;  // variable for value from potentiometer
int bulbBrightness;  // variable for value being sent to LED

void setup() {
  Serial.begin(9600);  // Setup serial communication
  pinMode(lightBulb, OUTPUT);  // Define Digital Pin 9 as OUTPUT
}

void loop() {

  dimmerValue = analogRead(dimmerController);
  Serial.println(dimmerValue);  // Print value from potentiometer

  bulbBrightness = map(dimmerValue, 0, 1023, 0, 255);
  // Map from Potentiometer's value to LED's value

  analogWrite(lightBulb, bulbBrightness);

}
