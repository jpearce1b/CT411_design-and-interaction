
import processing.serial.*;

Serial myPort;

int mode = 0;
float rotation = 0;
float pulse = 0;

void setup() {
  size(600, 480);
  smooth(8);
  colorMode(HSB, 360, 100, 100);

  printArray(Serial.list());

  // Change 0 to your Arduino's serial port index
  myPort = new Serial(this, Serial.list()[0], 9600);
  myPort.bufferUntil('\n');
}

void draw() {
  background(0);

  translate(width/2, height/2);

  rotation += 0.02;
  pulse += 0.05;

  if (mode == 1) {

    // Psychedelic pulsing circles
    noFill();
    strokeWeight(5);

    for (int i = 0; i < 20; i++) {
      float diameter = i * 35 +
                       sin(pulse + i * 0.4) * 30;

      stroke((frameCount * 3 + i * 20) % 360,
             100, 100);

      ellipse(0, 0, diameter, diameter);
    }

  } else if (mode == 2) {

    // Hypnotic spinning spiral
    rotate(rotation);

    noStroke();

    for (int i = 0; i < 120; i++) {
      float angle = i * 0.22;
      float radius = i * 2.4;

      float x = cos(angle) * radius;
      float y = sin(angle) * radius;

      fill((frameCount * 2 + i * 7) % 360,
           100, 100);

      ellipse(x, y, 20, 20);
    }
  } else {
    fill(0, 0, 100);
    textAlign(CENTER, CENTER);
    textSize(24);
    text("WAITING FOR SIGNAL...", 0, 0);
  }
}

void serialEvent(Serial port) {
  String incoming = port.readStringUntil('\n');

  if (incoming != null) {
    incoming = trim(incoming);

    if (incoming.equals("1")) {
      mode = 1;
    }

    if (incoming.equals("2")) {
      mode = 2;
    }
  }
}
