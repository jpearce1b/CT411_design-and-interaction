
int button = 2;
int button2 = 3;

void setup() {
  pinMode(button, INPUT_PULLUP);
  pinMode(button2, INPUT_PULLUP);

  Serial.begin(9600);
}

void loop() {
  if (digitalRead(button) == LOW) {
    Serial.println("1");
    delay(200);
  }

  if (digitalRead(button2) == LOW) {
    Serial.println("2");
    delay(200);
  }
}
