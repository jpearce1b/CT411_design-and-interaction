
int button = 2;


void setup() {
  // Set up the button as an input pin
  pinMode(button, INPUT_PULLUP);

  // Start serial communication
  Serial.begin(9600);
}

void loop() {
  // Check if button is pressed
  if (digitalRead(button) == LOW) {
    Serial.println("1");
    delay(200); // Debounce delay
  }

}
